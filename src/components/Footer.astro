---
import BrandMark from './BrandMark.astro';

const poster =
	'https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/4f690bd1-881a-4192-82f2-d714d34c8fb9.png';
const video =
	'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260901_122529_931c22c8-8d2d-47c0-ad51-b97f56a91e42.mp4';
---

<footer class="site-footer">
	<div class="footer-media" aria-hidden="true">
		<video class="footer-bg" autoplay muted loop playsinline preload="auto" poster={poster}>
			<source src={video} type="video/mp4" />
		</video>
	</div>
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="brand">
				<div class="brand-lockup">
					<BrandMark />
					<p class="brand-name">Stride</p>
				</div>
				<p class="brand-blurb">Stay interview-ready. 10 minutes a day.</p>
			</div>
			<nav class="col" aria-label="Product">
				<h2 class="col-title">Product</h2>
				<ul class="link-list">
					<li><a href="#how-it-works">How It Works</a></li>
					<li><a href="#features">Features</a></li>
					<li><a href="#join">Join Early Access</a></li>
				</ul>
			</nav>
			<nav class="col" aria-label="Topics">
				<h2 class="col-title">Topics</h2>
				<ul class="link-list">
					<li><a href="#topics">DSA</a></li>
					<li><a href="#topics">System Design</a></li>
					<li><a href="#topics">LLM &amp; Agents</a></li>
					<li><a href="#topics">Your Own Material</a></li>
				</ul>
			</nav>
			<nav class="col" aria-label="Why Stride">
				<h2 class="col-title">Why Stride</h2>
				<ul class="link-list">
					<li><a href="#different">Vs Leetcode</a></li>
					<li><a href="#different">Vs Youtube</a></li>
					<li><a href="#different">Vs Chatgpt</a></li>
				</ul>
			</nav>
			<div class="newsletter">
				<h2 class="col-title">Early Access</h2>
				<p>Free for the first 100 users. No credit card. Just sign up and start your daily prep.</p>
				<form class="subscribe" action="#join" method="get">
					<label class="sr-only" for="nl-email">Email address</label>
					<input
						id="nl-email"
						type="email"
						name="email"
						placeholder="Leave your email"
						autocomplete="email"
						required
					/>
					<button type="submit" aria-label="Subscribe">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 12h15M13 6l6 6-6 6"></path>
						</svg>
					</button>
				</form>
			</div>
		</div>
		<div class="footer-bottom">
			<div class="socials">
				<a href="#" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v3H6v4h3v8h4v-8h3.2l.8-4H13V9c0-.6.4-1 1-1z"
						></path>
					</svg>
				</a>
				<a href="#" aria-label="Twitter">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M14.6 3h3.1l-6.7 7.7L19 21h-5.2l-4.1-5.4L5.4 21H2.3l7.2-8.2L2 3h5.3l3.7 5L14.6 3zm-1 16.2h1.7L7.6 4.7H5.8l7.8 14.5z"
						></path>
					</svg>
				</a>
				<a href="#" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 2A1.8 1.8 0 1 0 13.8 12 1.8 1.8 0 0 0 12 10.2zM17.2 6.6a.9.9 0 1 1-.9.9.9.9 0 0 1 .9-.9z"
						></path>
					</svg>
				</a>
				<a href="#" aria-label="LinkedIn">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M6.5 9H3.5v12h3V9zM5 3.4A1.8 1.8 0 1 0 5 7a1.8 1.8 0 0 0 0-3.6zM20.5 13.4c0-3.2-1.7-4.7-4-4.7-1.9 0-2.7 1-3.2 1.7h-.1V9H10.3c.1 1.3 0 12 0 12h3v-6.7c0-1.8.3-3.5 2.5-3.5s2.2 1.7 2.2 3.5V21h3v-7.6z"
						></path>
					</svg>
				</a>
			</div>
			<nav class="legal" aria-label="Legal">
				<a href="#">Privacy Notice</a>
				<a href="#">Terms &amp; Policies</a>
				<a href="#">Cookie Notice</a>
				<span class="copyright">© 2026 Stride. All rights reserved.</span>
			</nav>
		</div>
	</div>
</footer>
